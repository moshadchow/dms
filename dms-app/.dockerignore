# =============================================================================
# Build context hygiene for the DMS frontend image.
#
# Everything excluded here is either rebuilt inside the image or irrelevant to
# the build. The point is a small, deterministic context and a layer cache that
# survives source-only edits.
# =============================================================================

# ── Dependencies: reinstalled by `npm ci` inside the image ──────────────────
node_modules

# ── Previous build output: rebuilt inside the image ─────────────────────────
dist
dist-ssr

# ── Local environment / secrets ─────────────────────────────────────────────
# Configuration reaches the image through --build-arg (VITE_*) and the
# container environment (DMS_*), never through a file from the workstation.
.env
.env.*
!.env.example

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Version control ─────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── CI / editors / OS ───────────────────────────────────────────────────────
.github
.vscode
.idea
.DS_Store
Thumbs.db
*.sw?

# ── Container plumbing (not needed inside the image) ────────────────────────
Dockerfile
.dockerignore
docker-compose*.yml
README.md
