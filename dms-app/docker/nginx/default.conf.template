# =============================================================================
# DMS frontend — nginx server block
#
# Rendered at container start by the nginx image's envsubst hook:
#   /etc/nginx/templates/default.conf.template
#     → /etc/nginx/conf.d/default.conf
#
# Only ${DMS_*} placeholders are substituted (NGINX_ENVSUBST_FILTER=^DMS_),
# so nginx's own $variables ($host, $uri, $remote_addr, ...) are left intact.
# =============================================================================

# Docker's embedded DNS resolves service names to the container's current IP.
# `resolve` on the upstream keeps nginx in sync when the backend is recreated
# with a new address. Override DMS_RESOLVER when the backend is addressed by
# IP or lives outside the Docker network.
resolver ${DMS_RESOLVER} valid=30s ipv6=off;
resolver_timeout 5s;

upstream dms_api {
    zone dms_api 64k;
    server ${DMS_API_HOST}:${DMS_API_PORT} resolve;
    keepalive 32;
}

server {
    listen      ${DMS_PORT};
    server_name ${DMS_SERVER_NAME};

    root  /usr/share/nginx/html;
    index index.html;

    charset     utf-8;
    server_tokens off;

    # ── Compression ─────────────────────────────────────────────────────────
    gzip              on;
    gzip_vary         on;
    gzip_proxied      any;
    gzip_comp_level   6;
    gzip_min_length   1024;
    gzip_types        text/plain text/css text/xml text/javascript
                      application/javascript application/json application/xml
                      application/rss+xml image/svg+xml font/ttf font/otf
                      font/woff font/woff2 application/wasm;

    # ── Security headers ───────────────────────────────────────────────────
    # add_header_inherit lets the locations below add their own Cache-Control
    # without dropping the headers declared here.
    add_header_inherit merge;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "${DMS_CSP}" always;

    # Document upload ceiling (frontend enforces 50 MB, leave headroom).
    client_max_body_size  ${DMS_MAX_UPLOAD_MB}m;
    client_body_timeout   300s;
    client_header_timeout 60s;

    # ── Health probe (backs the image HEALTHCHECK) ──────────────────────────
    location = /healthz {
        access_log   off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ── API: same-origin reverse proxy to the FastAPI backend ──────────────
    location /api/ {
        proxy_pass         http://dms_api;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        # Empty Connection header enables upstream keepalive.
        proxy_set_header Connection        "";

        proxy_connect_timeout 60s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;

        # A dead or unreachable backend must answer JSON, not the HTML 50x
        # page: the SPA parses error bodies to surface a message.
        error_page 502 503 504 = @api_unavailable;
        # Same for an upload that trips the size ceiling.
        error_page 413 = @payload_too_large;
    }

    location @api_unavailable {
        default_type application/json;
        return 502 '{"detail":"Backend service unavailable"}';
    }

    location @payload_too_large {
        default_type application/json;
        return 413 '{"detail":"File is too large"}';
    }

    # ── Fingerprinted build assets: cache forever ───────────────────────────
    # Only the Cache-Control header is set (no `expires`), so the response
    # carries exactly one cache directive instead of two conflicting ones.
    location /assets/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files  $uri =404;
        # A miss must not inherit the one-year policy of the hit path.
        error_page 404 = @asset_miss;
    }

    location @asset_miss {
        expires off;
        add_header Cache-Control "no-cache" always;
        return 404 "not found\n";
    }

    # ── Entry document: never cached ────────────────────────────────────────
    # index.html points at the hashed bundles; a stale copy pins the browser
    # to an old build, so it must always be revalidated.
    location = /index.html {
        expires off;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # ── SPA fallback ────────────────────────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
