# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/dms_db
DB_ECHO=false

# ── JWT ───────────────────────────────────────
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── File Storage ──────────────────────────────
STORAGE_ROOT=storage/uploads
MAX_FILE_SIZE_MB=50

# ── Backups (spec 35) ─────────────────────────
# Company-wise folder backup archives. Resolved against the app root like
# STORAGE_ROOT (relative) and MUST stay outside STORAGE_ROOT — a backup
# must never contain itself. The default deliberately avoids the name of
# the backups/ Python module (runtime data must never live in the source
# tree). The scheduler is an in-process asyncio loop (single uvicorn
# worker; disable in tests and multi-worker deployments).
BACKUP_ROOT=backups_data
BACKUP_SCHEDULER_ENABLED=true
BACKUP_SCHEDULER_TICK_SECONDS=300

# ── Database Backups (spec 36) ────────────────
# The PostgreSQL half of disaster recovery: pg_dump of dms_db itself
# (categories, users, workflows, correspondence and audit history live in
# the database, not on disk — spec 35's archives above cannot recover them).
# Resolved against the app root exactly like STORAGE_ROOT and BACKUP_ROOT,
# and MUST stay OUTSIDE BOTH — a dump must never sit in the tree it
# complements, and neither sibling backup may contain the other. A bad root
# is logged loudly at startup and degrades every dump to status=failed; it is
# never written to.
# The default deliberately avoids the bare name `db_backups`, which is the
# Python module next to core/ — runtime data must never land in the source tree.
DB_BACKUP_ROOT=db_backups_data
DB_BACKUP_SCHEDULER_ENABLED=true
DB_BACKUP_SCHEDULER_TICK_SECONDS=300
# pg_dump must be installed separately — it ships with the PostgreSQL server
# or the "client tools"/"postgresql-client" package, not with this app.
# Bare name = resolved on PATH. If it is NOT on PATH (common on Windows),
# set the absolute path, e.g.:
#   PG_DUMP_PATH=G:\Installer\PostgreSQL\18\bin\pg_dump.exe
PG_DUMP_PATH=pg_dump
# A hung dump is killed and recorded as `failed`; never left `running`.
PG_DUMP_TIMEOUT_SECONDS=3600

# ── CORS ──────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Azure AD / Microsoft Entra ID ─────────────
# Azure AD is configured PER COMPANY in the database (Company Profile →
# Azure AD), not through environment variables. No AZURE_CLIENT_ID /
# AZURE_CLIENT_SECRET / AZURE_TENANT_ID here — they are intentionally
# unsupported. Only this deployment's own callback URL belongs in .env.
AZURE_REDIRECT_URI=http://localhost:8000/api/v1/auth/azure/callback
FRONTEND_URL=http://localhost:5173

# ── Application ───────────────────────────────
DEBUG=true
APP_NAME=Document Management System
APP_VERSION=1.0.0

# ── Transport ─────────────────────────────────
# Dev: leave false — uvicorn is plain http://localhost:8000 behind the Vite proxy.
# Production (see dms-backend.service): set true; requests arriving with
# X-Forwarded-Proto: http (nginx) are 308-redirected to https. Requests
# without the header (internal /health, localhost) are never redirected.
FORCE_HTTPS=false
# Production values:
#   FORCE_HTTPS=true
#   FRONTEND_URL=https://dms.xpertfintech.com
#   AZURE_REDIRECT_URI=https://dms.xpertfintech.com/api/v1/auth/azure/callback
#   CORS_ORIGINS=["https://dms.xpertfintech.com"]

# ── Rate Limiting ─────────────────────────────
# Per-IP token buckets enforced by middleware/ratelimit.py (spec 31).
# 429 + Retry-After responses; nginx adds a matching edge limit_req on /api/
# (see dms.conf). Set RATE_LIMIT_ENABLED=false to disable in local dev.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_MAX_KEYS=10000

# ── SMTP / Email ──────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_FROM_NAME=DMS
