[Unit]
Description=DMS FastAPI Backend
After=network.target postgresql.service

[Service]
User=mchowdhury
WorkingDirectory=/var/www/dms
Environment="DATABASE_URL=postgresql+psycopg2://dmsuser:dmspass2026@127.0.0.1:5432/dmsdb"
Environment="CORS_ORIGINS=[\"http://192.168.101.34\"]"
ExecStart=/var/www/dms/venv/bin/python3 -m uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target











